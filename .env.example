# ============================================================
# WORKA SOLUTION - Environment Configuration
# Copy this file to `.env` and adjust the values.
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Docker / deployment
# ------------------------------------------------------------
# Public port exposed by docker-compose (maps to internal 8080).
PORT=8080

# Public base URL used for canonical links / Open Graph.
BASE_URL=http://localhost:8080

# ------------------------------------------------------------
# Admin credentials
# ------------------------------------------------------------
# Default login (seeded by the database migration):
#   username: worka_admin
#   password: worka2024!
#
# To change the password:
#   1. Generate a new Argon2 hash:
#        cargo run --example hash_password -- 'your-new-password'
#   2. Update the database inside the running container:
#        docker compose exec worka-solution sqlite3 /app/data/worka.db \
#          "UPDATE admin_users SET password_hash='<hash>' WHERE username='worka_admin';"
#
# Note: do NOT put the Argon2 hash in this .env file. It contains `$`
# characters that Docker Compose interprets as variables.
ADMIN_USERNAME=worka_admin

# Session secret must be at least 64 bytes. Generate one with:
#   openssl rand -hex 64
# If left unset, docker-compose.yml uses its built-in development
# default. Set this in production.
# SESSION_SECRET=<paste 128-char hex string here>

# ------------------------------------------------------------
# Application overrides (native binary, not Docker)
# The config crate reads env vars with the WORKA_ prefix and
# `_` as the nesting separator, e.g. WORKA_SERVER_PORT.
# ------------------------------------------------------------
# WORKA_SERVER_HOST=0.0.0.0
# WORKA_SERVER_PORT=8080
# WORKA_SERVER_BASE_URL=http://localhost:8080
# WORKA_DATABASE_URL=sqlite://data/worka.db?mode=rwc
# WORKA_DATABASE_MAX_CONNECTIONS=5
# WORKA_AUTH_ADMIN_USERNAME=worka_admin
# WORKA_AUTH_SESSION_SECRET=...
# WORKA_UPLOAD_MAX_SIZE_MB=10
# WORKA_UPLOAD_UPLOAD_DIR=static/uploads
# WORKA_APP_BRAND_NAME="WORKA SOLUTION"
# WORKA_APP_LEGAL_NAME="PT. WIH ORANG KAYA"

# Runtime mode: development | production
RUN_MODE=production

# Logging
RUST_LOG=info,worka_solution=debug
